{% set printFormat = displayMode == 'print' ? (request.get.print in ['a5', 'a4'] ? request.get.print : 'standard') : null %}
<div class="no-print qrcards-view-switch" role="group" aria-label="{{ _t('QRCARDS_VIEW_SELECTOR') }}">
  <a href="{{ url_with({print: null}) }}" class="yw-btn yw-btn--sm{{ displayMode == 'web' ? ' yw-btn--primary' : '' }}">{{ icon('eye') }} {{ _t('QRCARDS_VIEW_WEB') }}</a>
  {% for format in ['standard', 'a5', 'a4'] %}
    <a href="{{ url_with({print: format}) }}" class="yw-btn yw-btn--sm{{ printFormat == format ? ' yw-btn--primary' : '' }}" title="{{ _t('QRCARDS_FORMAT_' ~ format|upper ~ '_HINT') }}">{{ icon('printer') }} {{ _t('QRCARDS_VIEW_PRINT') }} {{ _t('QRCARDS_FORMAT_' ~ format|upper) }}</a>
  {% endfor %}
</div>
