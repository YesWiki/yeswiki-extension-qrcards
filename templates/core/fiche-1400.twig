{{ include_css('extensions/qrcards/styles/qrcards.css') }}
{{ include_javascript('extensions/qrcards/javascripts/qrcards.js') }}
{% set hidden = ['listeListeComplexite', 'bf_card_color', 'listeListeTypeCarte', 'imagebf_image', 'imagebf_picto_boite1', 'bf_texte_boite1', 'imagebf_picto_boite2', 'bf_texte_boite2', 'imagebf_picto_boite3', 'bf_texte_boite3', 'bf_url'] %}
{% if request.get.print is defined and request.get.print is not empty %}
  <div class="page-qrcard print">{{ renderAction('qrcard', {tag: entry.tag, view: 'print'})|raw }}</div>
{% else %}
  <div class="qrcard-entry-card">{{ renderAction('qrcard', {tag: entry.tag, view: 'web'})|raw }}</div>
  {% for field in form.prepared %}
    {% if field.propertyName not in hidden %}
      {{ field.renderStaticIfPermitted(entry)|raw }}
    {% endif %}
  {% endfor %}
{% endif %}
