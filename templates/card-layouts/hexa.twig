{{ include_css('extensions/qrcards/styles/hexa.css') }}
{{ include_javascript('extensions/qrcards/javascripts/hexa.js') }}
<div class="no-dblclick hexa-entry" data-tag="{{ entry.tag }}">
  <div class="hexa-card" tabindex="0">
    <figure class="hexagon front" style="background-color: {{ color }};">
      <div class="card-content">
        <div class="main-image">
          <img loading="lazy" alt="" src="{{ image ?: logo }}" />
        </div>
        <h1>{{ title }}</h1>
        <div class="hexa-card-text">{{ entry.bf_accroche ?? '' }}</div>
      </div>
      <span class="see-more">{{ icon('arrow-back-up') }}</span>
    </figure>
    <figure class="hexagon back" style="background-color: {{ color }};">
      <div class="card-content">
        <div class="hexa-card-longtext">{{ longText|raw }}</div>
      </div>
      <span class="see-more">{{ icon('arrow-back-up') }}</span>
    </figure>
  </div>
</div>
