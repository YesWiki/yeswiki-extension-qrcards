{% set titleClass = title|length > 80 ? 'title-xxl' : (title|length > 50 ? 'title-xl' : '') %}
{% set front %}
  <div class="qrcard front" style="background-color: {{ color }};">
    <div class="qrcard-header">
      <div class="complexity">{{ difficulty }}</div>
      <div class="card-type">{{ type }}</div>
    </div>
    <h2 class="qrcard-title {{ titleClass }}">{{ title }}</h2>
    <div class="qrcard-image">
      <img loading="lazy" alt="" src="{{ image ?: logo }}" />
    </div>
    <div class="qrcard-text">{{ entry.bf_accroche ?? '' }}</div>
    <div class="qrcard-footer">
      <img loading="lazy" class="logo" alt="" src="{{ setLogo }}" />
      {% for picto in pictos %}
        <div class="boite{{ loop.index }}">
          <div class="mini-picto">{% if picto.image %}<img loading="lazy" src="{{ picto.image }}" alt="" />{% endif %}</div>
          <div class="mini-text">{{ picto.text }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endset %}
{% set back %}
  <div class="qrcard back" style="background-color: {{ color }};">
    <div class="qrcard-header">
      <div class="complexity">{{ difficulty }}</div>
      <div class="card-type">{{ type }}</div>
    </div>
    <h2 class="qrcard-title {{ titleClass }}">{{ title }}</h2>
    <div class="qrcard-main-content">{{ longText|raw }}</div>
    <div class="qrcard-footer">
      <img loading="lazy" class="logo" alt="" src="{{ setLogo }}" />
      <div class="link">
        <a class="card-link" href="{{ link }}">{{ shortLink }}</a>
        <img loading="lazy" class="logo-cc" src="{{ license }}" alt="CC BY SA" />
      </div>
      <div class="qrcode"><img src="{{ qrcode }}" alt="{{ link }}" /></div>
    </div>
  </div>
{% endset %}
{% if view == 'print' %}
  <div class="qrcard-to-print" data-tag="{{ entry.tag }}">
    {{ front }}
    {{ back }}
    {% if currentPage != entry.tag %}
      <div class="qrcard-actions no-print">
        <button type="button" class="yw-btn yw-btn--sm yw-btn--danger qrcard-remove-from-print">{{ icon('x') }} {{ _t('QRCARDS_DONT_PRINT') }}</button>
      </div>
    {% endif %}
  </div>
{% else %}
  <div class="card-plus-actions-container" data-tag="{{ entry.tag }}">
    <div class="flip-container" tabindex="0">
      <div class="flipper">
        {{ front }}
        {{ back }}
      </div>
    </div>
    <div class="qrcard-actions no-print">
      {% if favoriteUser %}
        {{ include_javascript('javascripts/favorites.js') }}
        <a href="#" class="favorites{{ isFavorite ? ' user-favorite' : '' }}" title="{{ isFavorite ? _t('FAVORITES_REMOVE') : _t('FAVORITES_ADD') }}" data-resource="{{ entry.tag }}" data-user="{{ favoriteUser }}">
          {{ icon(isFavorite ? 'star-filled' : 'star') }} {{ _t('QRCARDS_FAVORI') }}
        </a>
      {% else %}
        <span></span>
      {% endif %}
      <div class="card-edit-links">
        {% if currentPage != entry.tag %}
          <a class="yw-btn yw-btn--sm" href="{{ viewUrl }}" title="{{ _t('QRCARDS_VIEW') }}">{{ icon('eye') }}</a>
        {% endif %}
        {% if editUrl %}
          <a class="yw-btn yw-btn--sm" href="{{ editUrl }}" title="{{ _t('QRCARDS_EDIT') }}">{{ icon('pencil') }}</a>
        {% endif %}
        <div class="yw-dropdown">
          <button type="button" class="yw-btn yw-btn--sm" data-yw-dropdown-toggle aria-haspopup="true" aria-expanded="false" title="{{ _t('DUPLICATE_CARD') }}">{{ icon('copy') }}</button>
          <ul class="yw-dropdown__menu yw-dropdown__menu--right">
            <li><a href="{{ duplicateUrl }}">{{ _t('TEMPLATE_DUPLICATE_LOCALLY') }}</a></li>
            <li><a href="{{ duplicateRemoteUrl }}">{{ _t('TEMPLATE_DUPLICATE_IN_ANOTHER_WIKI') }}</a></li>
          </ul>
        </div>
        <a class="yw-btn yw-btn--sm" href="{{ printUrl }}" title="{{ _t('QRCARDS_PRINT') }}">{{ icon('printer') }}</a>
        {% if deleteUrl %}
          <a class="yw-btn yw-btn--sm yw-btn--danger modalbox" href="{{ deleteUrl }}" title="{{ _t('QRCARDS_DELETE') }}" data-confirm-text="{{ _t('BAZ_CONFIRM_SUPPRIMER_FICHE') }}">{{ icon('trash') }}</a>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}
